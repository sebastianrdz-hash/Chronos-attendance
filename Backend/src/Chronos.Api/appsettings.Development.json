{
  // Valores pensados para correr contra el docker-compose del repositorio.
  // La llave y la contraseña de aquí son de desarrollo local: en cualquier otro
  // entorno se sobrescriben con las variables Jwt__Llave y Semilla__Contrasena.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=chronos;Username=chronos;Password=chronos_dev"
  },
  // El cliente llama a la API por el proxy de Vite, así que en el navegador todo queda
  // en el mismo origen y CORS no llega a intervenir. Estos valores solo cubren el caso
  // de apuntar el cliente directo a la API con VITE_API_URL.
  "Cors": {
    "OrigenesPermitidos": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Jwt": {
    "Emisor": "chronos-api",
    "Audiencia": "chronos-client",
    "Llave": "llave-solo-para-desarrollo-local-no-usar-en-produccion-2026",
    "MinutosVigencia": 480
  },
  // Llave separada de la del JWT para poder rotar la firma de los códigos sin cerrar
  // todas las sesiones abiertas. En otros entornos se sobrescribe con Qr__Llave.
  "Qr": {
    "Llave": "llave-qr-solo-para-desarrollo-local-no-usar-en-produccion-2026",
    "SegundosVigencia": 30,
    "SegundosGracia": 5,
    "PixelesImagen": 512
  },
  // El RP ID describe lo que ve el NAVEGADOR (el host de Vite), no el puerto de la API.
  // Tiene que ser un nombre de dominio: la norma WebAuthn prohíbe las direcciones IP, así
  // que probar desde el celular contra la IP de red local no funciona. Ver el README.
  //
  // Si Vite arranca en otro puerto porque el 5173 está ocupado, WebAuthn falla por origen
  // con un mensaje que no menciona el puerto. Antes de perseguir el error, comprueba en
  // qué puerto quedó el cliente y agrégalo aquí.
  "WebAuthn": {
    "RpId": "localhost",
    "NombreRp": "Chronos",
    "OrigenesPermitidos": [
      "https://localhost:5173",
      "http://localhost:5173"
    ],
    "SegundosVigenciaDesafio": 120
  },
  "Semilla": {
    "EjecutarAlIniciar": true,
    "Contrasena": "Chronos#2026"
  }
}
