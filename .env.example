# Plantilla de configuración. Cópiala como .env y ajusta los valores:
#
#   Copy-Item .env.example .env
#
# El .env real está en .gitignore porque ahí viven los secretos de tu máquina.
# Este archivo sí se versiona para que quien clone el repo sepa qué necesita.

# --- PostgreSQL (lo lee docker-compose) ---
POSTGRES_DB=chronos
POSTGRES_USER=chronos
POSTGRES_PASSWORD=chronos_dev
# 5433 evita chocar con un PostgreSQL instalado de forma nativa en el 5432.
POSTGRES_PORT=5433
ADMINER_PORT=8080

# --- API ---
# Estas variables NO las lee "dotnet run": para desarrollo local los valores
# vienen de Backend/src/Chronos.Api/appsettings.Development.json. Se usan cuando
# la API corre en contenedor o cuando las exportas a mano para sobrescribir.
# El doble guion bajo es el separador de secciones de la configuración de .NET.
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=chronos;Username=chronos;Password=chronos_dev

# Mínimo 32 caracteres. Genera uno con:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
Jwt__Llave=cambia-esta-llave-por-un-secreto-de-al-menos-32-caracteres
Jwt__MinutosVigencia=60

# Contraseña de las cuentas semilla. Cámbiala fuera de desarrollo.
Semilla__Contrasena=Chronos#2026
Semilla__EjecutarAlIniciar=true

# --- Despliegue (Render / Neon / Vercel) ---
# Neon entrega DATABASE_URL como URI; la API la traduce sola a formato Npgsql.
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/chronos?sslmode=require
#
# Origen del cliente en Vercel. El índice 0 es cómo .NET mapea un arreglo desde el entorno.
# Cors__OrigenesPermitidos__0=https://tu-app.vercel.app
#
# Swagger en la demo pública. En local no hace falta: Development ya lo expone.
# Api__ExponerDocumentacion=true
#
# El cliente de Vite hornea VITE_API_URL en el build: hay que redesplegar Vercel si cambia.
# VITE_API_URL=https://tu-api.onrender.com/api/v1
